{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "grep *": "allow",
      "ls *": "allow",
      "cd *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "echo *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "file *": "allow",
      "which *": "allow",
      "wc *": "allow",
      "tree *": "allow",
      "stat *": "allow",
      "diff *": "allow",
      "du *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "date": "allow",
      "uname *": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git branch*": "allow",
      "git show*": "allow",
      "git remote*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "openspec *": "allow",
      "mkdir *": "allow",
      "tuicr *": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "deny",
    "external_directory": "ask",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "list": "allow"
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "build/**",
      "*.log",
      "typings/**",
      "*.pyc",
      "__pycache__/**",
      "_site/**",
      "target/**",
      "dist/**",
      "docs/**"
    ]
  },
  "model": "opencode-go/deepseek-v4-flash",
  "small_model": "opencode-go/deepseek-v4-flash",
  "share": "manual",
  "autoupdate": false,
  "provider": {
    "opencode-go": {
      "models": {
        "qwen3.6-plus": {
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "gemma-4-e4b-claude-4.6-opus-reasoning-distilled": {
          "name": "Gemma 4 E4B"
        }
      }
    }
  }
}

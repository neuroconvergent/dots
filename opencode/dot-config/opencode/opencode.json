{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "deny",
    "external_directory": "ask"
  },
  "tools": {
    "write": true,
    "bash": false,
    "webfetch": false
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "build/**",
      "*.log",
      "typings/**",
      "*.pyc",
      "__pycache__/**",
      "_site/**",
      "target/**",
      "dist/**",
      "docs/**"
    ]
  },
  "model": "opencode-go/kimi-k2.5",
  "small_model": "opencode-go/minimax-m2.5",
  "share": "manual",
  "autoupdate": false,
  "provider": {
    "opencode-go": {
      "models": {
        "qwen3.6-plus": {
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "gemma-4-e4b-claude-4.6-opus-reasoning-distilled": {
          "name": "Gemma 4 E4B"
        }
      }
    }
  }
}

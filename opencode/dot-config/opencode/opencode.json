{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "deny",
    "external_directory": "ask"
  },
  "tools": {
    "write": true,
    "bash": false,
    "webfetch": false
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "build/**",
      "*.log",
      "typings/**",
      "*.pyc",
      "__pycache__/**",
      "_site/**",
      "target/**",
      "dist/**",
      "docs/**"
    ]
  },
  "model": "opencode-go/qwen3.5-plus",
  "small_model": "opencode-go/minimax-m2.5",
  "share": "manual",
  "autoupdate": false,
  "provider": {
    "opencode": {
      "models": {}
    }
  }
}
